# using numpy

import numpy as np
import matplotlib.pyplot as plt

# NumPy配列で膜電位データを作成
time = np.arange(8)  # 0から7まで自動生成
voltage_array = np.array([-68, -66, -64, -62, -60, -58, -56, -54])

# NumPyは配列全体に一気に計算可能
print(voltage_array + 10)   # 全要素に10を足す
print(voltage_array.mean()) # 平均
print(voltage_array.max())  # 最大値

# スライス：特定の範囲を切り出す
print(voltage_array[0])    # 最初の要素
print(voltage_array[-1])   # 最後の要素
print(voltage_array[2:5])  # 3番目から5番目

# グラフで可視化
plt.plot(time, voltage_array, marker='o')
plt.axhline(y=-55.0, color='red', linestyle='--', label='threshold')
plt.xlabel('time(s)')
plt.ylabel('voltage(mV)')
plt.legend()
plt.show()
