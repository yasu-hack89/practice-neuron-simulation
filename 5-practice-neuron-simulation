import mne
from mne.datasets.sleep_physionet.age import fetch_data

files = fetch_data(subjects=[0], recording=[1])
raw=mne.io.read_raw_edf(files[0][0], preload=True)
annotations=mne.read_annotations(files[0][1])
raw.set_annotations(annotations)

rem_annotations=[a for a in annotations if 'R' in a ['description']]
print(f"Rem-sleep count:{len(rem_annotations)}")


onset=rem_annotations[0]['onset']
duration=rem_annotations[0]['duration']

rem_raw=raw.copy().crop(tmin=onset, tmax=onset+duration)
print(f"cutting section:{duration}s")


import matplotlib.pyplot as plt

rem_eeg=rem_raw.copy().pick(['EEG Fpz-Cz', 'EEG Pz-Oz'])

fig=rem_eeg.compute_psd(fmax=30).plot()
plt.show()


nrem_annotations=[a for a in annotations if '2' in a['description']]
onset_nrem=nrem_annotations[0]['onset']
duration_nrem=nrem_annotations[0]['duration']

nrem_raw=raw.copy().crop(tmin=onset_nrem, tmax=onset_nrem+duration_nrem)
nrem_eeg=nrem_raw.copy().pick(['EEG Fpz-Cz', 'EEG Pz-Oz'])

fig=nrem_eeg.compute_psd(fmax=30).plot()
plt.show()


import numpy as np

psd_rem=rem_eeg.compute_psd(fmax=30)
psd_nrem=nrem_eeg.compute_psd(fmax=30)

freqs=psd_rem.freqs
power_rem=psd_rem.get_data().mean(axis=0)
power_nrem=psd_nrem.get_data().mean(axis=0)

plt.figure(figsize=(10,5))
plt.plot(freqs,10*np.log10(power_rem), label='rem', color='red')
